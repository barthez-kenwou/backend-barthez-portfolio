// Education entries (matches frontend IEducation)

model Education {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  degreeFr  String
  degreeEn  String
  school    String
  period    String
  link      String?
  sortOrder Int       @default(0)
  ownerId   String?   @db.ObjectId
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([sortOrder])
  @@index([deletedAt])
}
