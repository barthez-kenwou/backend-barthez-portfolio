// Portfolio skills (matches frontend ISkill / IAdminSkill)

model Skill {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  category  String
  level     Int
  icon      String
  sortOrder Int       @default(0)
  ownerId   String?   @db.ObjectId
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([category])
  @@index([sortOrder])
  @@index([deletedAt])
}
