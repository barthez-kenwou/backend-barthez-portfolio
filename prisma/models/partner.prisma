// Organizations / structures that trusted a collaboration (homepage logo strip)

model Partner {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  name          String
  logoUrl       String
  websiteUrl    String?
  descriptionFr String?
  descriptionEn String?
  relationFr    String?
  relationEn    String?
  sortOrder     Int       @default(0)
  isPublished   Boolean   @default(true)
  ownerId       String?   @db.ObjectId
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  @@index([sortOrder])
  @@index([isPublished])
  @@index([deletedAt])
}
