// Inbound contact form messages (matches frontend IContactResponse)

enum ContactResponseStatus {
  new
  read
  archived
  replied
}

model ContactResponse {
  id        String                @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  email     String
  subject   String
  message   String
  status    ContactResponseStatus @default(new)
  notes     String?
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt
  deletedAt DateTime?

  @@index([status, createdAt])
  @@index([deletedAt])
}
