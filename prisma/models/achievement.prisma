// Public achievement counters (matches frontend IAchievement)

model Achievement {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  iconKey   String
  value     String
  labelFr   String
  labelEn   String
  sortOrder Int       @default(0)
  ownerId   String?   @db.ObjectId
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([sortOrder])
  @@index([deletedAt])
}
