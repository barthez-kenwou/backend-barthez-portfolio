<%
  var isEn = typeof locale !== 'undefined' && locale === 'en';
  var pageTitle = isEn ? 'Unsubscribed' : 'Désabonnement confirmé';
%>
<%- include('partials/newsletter-shell-open', { pageTitle: pageTitle, eyebrow: isEn ? 'Confirmed' : 'Confirmé', title: pageTitle }) %>
<tr>
  <td style="padding:32px 28px 26px;background-color:#0e0c11;">
    <p style="margin:0 0 14px;font-size:16px;line-height:1.7;color:#f7f7f7;">
      <%= isEn ? 'Hello' : 'Bonjour' %>,
    </p>
    <p style="margin:0 0 14px;font-size:15px;line-height:1.75;color:#948b9c;">
      <% if (isEn) { %>
        Your subscription has been cancelled. You will no longer receive newsletter emails from Barthez Kenwou.
        The blog remains available whenever you want technical notes without the inbox.
      <% } else { %>
        Votre abonnement a bien été annulé. Vous ne recevrez plus d’emails newsletter de Barthez Kenwou.
        Le blog reste disponible lorsque vous souhaitez des notes techniques sans la boîte mail.
      <% } %>
    </p>
    <div style="text-align:center;margin:26px 0 8px;">
      <a href="<%= blogUrl %>" style="display:inline-block;background-color:#9f6adc;color:#ffffff;padding:13px 26px;text-decoration:none;border-radius:6px;font-weight:700;font-size:14px;border:1px solid #803ecc;">
        <%= isEn ? 'Back to the blog' : 'Retour au blog' %>
      </a>
    </div>
    <p style="margin:24px 0 0;font-size:14px;line-height:1.6;color:#f7f7f7;">
      <%= isEn ? 'Kind regards,' : 'Cordialement,' %><br/>
      <strong style="color:#ffffff;">Barthez Kenwou</strong>
    </p>
  </td>
</tr>
<%- include('partials/newsletter-shell-close') %>
