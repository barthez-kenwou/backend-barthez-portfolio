          <tr>
            <td style="background-color:#0a080c;border-top:1px solid #211d25;padding:24px 28px 22px;text-align:center;">
              <% if (tagline) { %>
                <p style="margin:0 0 10px;font-size:13px;color:#f7f7f7;font-weight:600;"><%= tagline %></p>
              <% } %>
              <p style="margin:0 0 14px;font-size:12px;line-height:1.6;color:#948b9c;">
                <% if (typeof locale !== 'undefined' && locale === 'en') { %>
                  You receive this email because you subscribed to technical notes from <%= brandName %>. One edition per month.
                <% } else { %>
                  Vous recevez cet email car vous vous êtes inscrit aux notes techniques de <%= brandName %>. Une édition par mois.
                <% } %>
              </p>
              <% if (socials && socials.length) { %>
                <div style="margin:8px 0 12px;">
                  <% socials.forEach(function (s) { %>
                    <a href="<%= s.url %>" style="display:inline-block;margin:0 4px 6px;padding:6px 11px;border-radius:6px;background:#0e0c11;border:1px solid #211d25;color:#9f6adc;font-size:11px;font-weight:600;text-decoration:none;"><%= s.label %></a>
                  <% }) %>
                </div>
              <% } %>
              <% if (typeof unsubscribeUrl !== 'undefined' && unsubscribeUrl) { %>
                <p style="margin:0 0 8px;font-size:11px;color:#948b9c;">
                  <a href="<%= unsubscribeUrl %>" style="color:#948b9c;text-decoration:underline;"><%= typeof locale !== 'undefined' && locale === 'en' ? 'Unsubscribe' : 'Se désabonner' %></a>
                </p>
              <% } %>
              <p style="margin:10px 0 0;font-size:11px;color:#948b9c;">
                &copy; <%= year %> <%= company || brandName %>. <%= typeof locale !== 'undefined' && locale === 'en' ? 'All rights reserved.' : 'Tous droits réservés.' %>
              </p>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
