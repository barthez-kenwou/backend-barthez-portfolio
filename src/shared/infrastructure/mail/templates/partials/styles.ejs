<%#
  Shared CSS for transactional mail — Pearl & Amethyst (barthez-kenwou.dev).
  Colors come from `colors` (MAIL_BRAND_* / mail-brand.constants defaults).
%>
<style>
  body {
    margin: 0;
    padding: 0;
    width: 100% !important;
    -webkit-text-size-adjust: 100%;
    -ms-text-size-adjust: 100%;
    background-color: <%= colors.canvas %>;
    color: <%= colors.text %>;
    font-family: Inter, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
  }
  table { border-collapse: collapse; mso-table-lspace: 0pt; mso-table-rspace: 0pt; }
  img { border: 0; outline: none; text-decoration: none; -ms-interpolation-mode: bicubic; display: block; }
  a { color: <%= colors.primary %>; }
  .mail-wrap { width: 100%; background-color: <%= colors.canvas %>; padding: 40px 12px; }
  .mail-card {
    width: 100%;
    max-width: 600px;
    background-color: <%= colors.card %>;
    border-radius: 10px;
    overflow: hidden;
    border: 1px solid <%= colors.border %>;
    box-shadow: 0 18px 48px rgba(36, 26, 46, 0.08);
  }
  .mail-spectrum td { height: 4px; font-size: 0; line-height: 0; }
  .mail-header {
    padding: 40px 36px 32px;
    text-align: center;
    color: <%= colors.onPrimary %>;
  }
  .mail-header h1 {
    margin: 14px 0 0;
    font-size: 26px;
    line-height: 1.25;
    font-weight: 700;
    letter-spacing: -0.03em;
    color: <%= colors.onPrimary %>;
  }
  .mail-header .eyebrow {
    margin: 0;
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    opacity: 0.88;
    font-weight: 600;
    font-family: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  }
  .mail-logo {
    max-height: 48px;
    max-width: 200px;
    margin: 0 auto 10px;
  }
  .mail-brand-mark {
    display: inline-block;
    width: 52px;
    height: 52px;
    line-height: 52px;
    border-radius: 10px;
    background: rgba(255,255,255,0.14);
    border: 1px solid rgba(255,255,255,0.22);
    font-size: 16px;
    font-weight: 700;
    color: <%= colors.onPrimary %>;
    letter-spacing: 0.06em;
    font-family: Inter, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
  }
  .mail-body { padding: 36px 36px 28px; text-align: left; }
  .mail-body h2 {
    margin: 0 0 12px;
    font-size: 20px;
    line-height: 1.35;
    color: <%= colors.text %>;
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  .mail-body p {
    margin: 0 0 14px;
    font-size: 15px;
    line-height: 1.7;
    color: <%= colors.textMuted %>;
  }
  .mail-body strong { color: <%= colors.text %>; }
  .mail-highlight { color: <%= colors.primary %>; font-weight: 600; }
  .mail-panel {
    border-radius: 8px;
    padding: 18px 20px;
    margin: 22px 0;
    font-size: 14px;
    line-height: 1.65;
    color: <%= colors.text %>;
  }
  .mail-panel-brand {
    background: <%= colors.primarySoft %>;
    border-left: 3px solid <%= colors.primary %>;
  }
  .mail-panel-success {
    background: <%= colors.successSoft %>;
    border-left: 3px solid <%= colors.success %>;
  }
  .mail-panel-warning {
    background: <%= colors.warningSoft %>;
    border-left: 3px solid <%= colors.warning %>;
  }
  .mail-panel-danger {
    background: <%= colors.dangerSoft %>;
    border-left: 3px solid <%= colors.danger %>;
  }
  .mail-code {
    background: <%= colors.primarySoft %>;
    border: 1px solid <%= colors.primary %>;
    color: <%= colors.ink %>;
    font-weight: 700;
    font-size: 34px;
    letter-spacing: 12px;
    text-align: center;
    border-radius: 8px;
    padding: 24px 12px;
    margin: 24px 0;
    font-family: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  }
  .mail-cta { text-align: center; margin: 28px 0 8px; }
  .mail-btn {
    display: inline-block;
    background-color: <%= colors.primary %>;
    color: <%= colors.onPrimary %> !important;
    padding: 14px 30px;
    text-decoration: none;
    border-radius: 6px;
    font-weight: 700;
    font-size: 14px;
    letter-spacing: 0.02em;
    border: 1px solid <%= colors.primaryDark %>;
  }
  .mail-btn-danger { background-color: <%= colors.danger %>; border-color: <%= colors.dangerDark %>; }
  .mail-btn-success { background-color: <%= colors.success %>; border-color: <%= colors.successDark %>; }
  .mail-meta-row {
    padding: 10px 0;
    border-bottom: 1px dashed <%= colors.border %>;
    font-size: 14px;
  }
  .mail-meta-row:last-child { border-bottom: 0; }
  .mail-meta-label {
    color: <%= colors.textMuted %>;
    font-weight: 600;
    display: block;
    margin-bottom: 3px;
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-family: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  }
  .mail-meta-value { color: <%= colors.text %>; word-break: break-word; }
  .mail-stack {
    background: <%= colors.ink %>;
    color: #f7f7f7;
    border-radius: 8px;
    padding: 14px;
    margin-top: 10px;
    font-family: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 12px;
    white-space: pre-wrap;
    overflow-x: auto;
  }
  .mail-footer {
    background: <%= colors.footerBg %>;
    border-top: 1px solid <%= colors.border %>;
    padding: 28px 28px 24px;
    text-align: center;
  }
  .mail-footer p {
    margin: 0 0 8px;
    font-size: 12px;
    line-height: 1.65;
    color: <%= colors.textMuted %>;
  }
  .mail-footer a {
    color: <%= colors.primary %>;
    text-decoration: none;
    font-weight: 600;
  }
  .mail-social { margin: 16px 0 8px; }
  .mail-social a {
    display: inline-block;
    margin: 0 5px;
    padding: 7px 12px;
    border-radius: 6px;
    background: <%= colors.card %>;
    border: 1px solid <%= colors.border %>;
    color: <%= colors.primaryDark %>;
    font-size: 11px;
    font-weight: 600;
    text-decoration: none;
    letter-spacing: 0.02em;
  }
  .mail-legal a {
    color: <%= colors.textMuted %>;
    text-decoration: underline;
    font-weight: 500;
    margin: 0 6px;
  }
  @media only screen and (max-width: 620px) {
    .mail-body, .mail-header { padding-left: 22px !important; padding-right: 22px !important; }
    .mail-code { font-size: 26px; letter-spacing: 6px; }
  }
</style>
