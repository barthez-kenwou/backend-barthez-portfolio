<%#
  Dark newsletter shell — Brilliant Obscure (site default).
  locals: pageTitle, previewText?
%>
<!DOCTYPE html>
<html lang="<%= typeof locale !== 'undefined' && locale === 'en' ? 'en' : 'fr' %>" xmlns="http://www.w3.org/1999/xhtml">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="color-scheme" content="dark" />
  <meta name="supported-color-schemes" content="dark" />
  <title><%= typeof pageTitle !== 'undefined' ? pageTitle : brandName %></title>
  <!--[if !mso]><!-->
  <style>
    body, table, td { font-family: Inter, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; }
  </style>
  <!--<![endif]-->
</head>
<body style="margin:0;padding:0;background-color:#080609;">
  <% if (typeof previewText !== 'undefined' && previewText) { %>
    <div style="display:none;max-height:0;overflow:hidden;opacity:0;"><%= previewText %>&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;</div>
  <% } %>
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;background-color:#080609;padding:40px 12px;">
    <tr>
      <td align="center">
        <table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0" style="width:100%;max-width:600px;background-color:#0e0c11;border-radius:10px;overflow:hidden;border:1px solid #211d25;">
          <tr>
            <td style="padding:0;line-height:0;font-size:0;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                <tr>
                  <td width="34%" style="height:4px;background-color:#a78bfa;font-size:0;line-height:0;">&nbsp;</td>
                  <td width="33%" style="height:4px;background-color:#22d3ee;font-size:0;line-height:0;">&nbsp;</td>
                  <td width="33%" style="height:4px;background-color:#f0abfc;font-size:0;line-height:0;">&nbsp;</td>
                </tr>
              </table>
            </td>
          </tr>
          <tr>
            <td style="background-color:#241a2e;background-image:linear-gradient(135deg,#080609 0%,#3b1f6e 50%,#9f6adc 100%);padding:36px 32px 28px;text-align:center;">
              <% if (logoUrl) { %>
                <img src="<%= logoUrl %>" alt="<%= brandName %>" width="140" style="max-height:44px;max-width:180px;margin:0 auto 12px;height:auto;display:block;" />
              <% } else { %>
                <div style="display:inline-block;width:48px;height:48px;line-height:48px;border-radius:10px;background:rgba(159,106,220,0.25);border:1px solid rgba(159,106,220,0.45);font-size:15px;font-weight:700;color:#ffffff;letter-spacing:0.06em;"><%= monogram || 'BK' %></div>
              <% } %>
              <% if (typeof eyebrow !== 'undefined' && eyebrow) { %>
                <p style="margin:12px 0 0;font-size:11px;letter-spacing:0.16em;text-transform:uppercase;color:rgba(247,247,247,0.75);font-weight:600;"><%= eyebrow %></p>
              <% } %>
              <% if (typeof title !== 'undefined' && title) { %>
                <h1 style="margin:10px 0 0;font-size:24px;line-height:1.3;font-weight:700;color:#ffffff;letter-spacing:-0.02em;"><%= title %></h1>
              <% } %>
            </td>
          </tr>
