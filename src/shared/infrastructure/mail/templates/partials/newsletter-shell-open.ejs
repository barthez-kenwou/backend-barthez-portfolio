<%#
  Dark newsletter shell — Brilliant Obscure (site default).
  locals: pageTitle, previewText?, eyebrow?, title?
%>
<!DOCTYPE html>
<html lang="<%= typeof locale !== 'undefined' && locale === 'en' ? 'en' : 'fr' %>" xmlns="http://www.w3.org/1999/xhtml">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="color-scheme" content="dark" />
  <meta name="supported-color-schemes" content="dark" />
  <title><%= typeof pageTitle !== 'undefined' ? pageTitle : brandName %></title>
  <!--[if !mso]><!-->
  <style>
    body, table, td { font-family: 'Segoe UI', system-ui, -apple-system, Helvetica, Arial, sans-serif; }
  </style>
  <!--<![endif]-->
</head>
<body style="margin:0;padding:0;background-color:#080609;">
  <% if (typeof previewText !== 'undefined' && previewText) { %>
    <div style="display:none;max-height:0;overflow:hidden;opacity:0;"><%= previewText %>&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;</div>
  <% } %>
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;background-color:#080609;padding:32px 12px;">
    <tr>
      <td align="center">
        <table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0" style="width:100%;max-width:600px;background-color:#0e0c11;border-radius:8px;overflow:hidden;border:1px solid #211d25;">
          <tr>
            <td style="padding:0;line-height:0;font-size:0;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                <tr>
                  <td width="40%" style="height:3px;background-color:#9f6adc;font-size:0;line-height:0;">&nbsp;</td>
                  <td width="35%" style="height:3px;background-color:#7c5cbf;font-size:0;line-height:0;">&nbsp;</td>
                  <td width="25%" style="height:3px;background-color:#532791;font-size:0;line-height:0;">&nbsp;</td>
                </tr>
              </table>
            </td>
          </tr>
          <tr>
            <td style="background-color:#16121c;background-image:linear-gradient(160deg,#080609 0%,#241a2e 55%,#3b1f6e 100%);padding:28px 28px 22px;text-align:center;">
              <% if (logoUrl) { %>
                <img src="<%= logoUrl %>" alt="<%= brandName %>" width="132" style="max-height:40px;max-width:160px;margin:0 auto 10px;height:auto;display:block;" />
              <% } else { %>
                <div style="display:inline-block;width:44px;height:44px;line-height:44px;border-radius:8px;background:rgba(159,106,220,0.22);border:1px solid rgba(159,106,220,0.4);font-size:14px;font-weight:700;color:#ffffff;letter-spacing:0.06em;"><%= monogram || 'BK' %></div>
              <% } %>
              <% if (typeof eyebrow !== 'undefined' && eyebrow) { %>
                <p style="margin:10px 0 0;font-size:11px;letter-spacing:0.14em;text-transform:uppercase;color:rgba(247,247,247,0.72);font-weight:600;"><%= eyebrow %></p>
              <% } %>
              <% if (typeof title !== 'undefined' && title) { %>
                <h1 style="margin:8px 0 0;font-size:22px;line-height:1.35;font-weight:700;color:#ffffff;letter-spacing:-0.02em;"><%= title %></h1>
              <% } %>
            </td>
          </tr>
