<%#
  locals: eyebrow?, title, tone? ('brand'|'success'|'warning'|'danger')
%>
<%
  var headerTone = 'brand';
  if (typeof tone === 'string' && tone) headerTone = tone;
  var g = headerGradient(headerTone);
%>
<tr>
  <td style="padding:0;line-height:0;font-size:0;">
    <table role="presentation" class="mail-spectrum" width="100%" cellpadding="0" cellspacing="0" border="0">
      <tr>
        <td width="34%" style="height:4px;background-color:<%= colors.spectrum1 %>;font-size:0;line-height:0;">&nbsp;</td>
        <td width="33%" style="height:4px;background-color:<%= colors.spectrum2 %>;font-size:0;line-height:0;">&nbsp;</td>
        <td width="33%" style="height:4px;background-color:<%= colors.spectrum3 %>;font-size:0;line-height:0;">&nbsp;</td>
      </tr>
    </table>
  </td>
</tr>
<tr>
  <td class="mail-header" style="background-color:<%= g.from %>;background-image:linear-gradient(135deg, <%= g.from %> 0%, <%= g.mid %> 55%, <%= g.to %> 100%);padding:40px 36px 32px;text-align:center;color:<%= colors.onPrimary %>;">
    <% if (logoUrl) { %>
      <img class="mail-logo" src="<%= logoUrl %>" alt="<%= brandName %>" width="160" style="max-height:48px;max-width:200px;margin:0 auto 12px;height:auto;" />
    <% } else { %>
      <div class="mail-brand-mark" style="display:inline-block;width:52px;height:52px;line-height:52px;border-radius:10px;background:rgba(255,255,255,0.14);border:1px solid rgba(255,255,255,0.22);font-size:16px;font-weight:700;color:<%= colors.onPrimary %>;letter-spacing:0.06em;"><%= monogram || 'BK' %></div>
    <% } %>
    <% if (typeof eyebrow !== 'undefined' && eyebrow) { %>
      <p class="eyebrow" style="margin:14px 0 0;font-size:11px;letter-spacing:0.16em;text-transform:uppercase;opacity:0.9;font-weight:600;color:<%= colors.onPrimary %>;font-family:'JetBrains Mono',ui-monospace,Menlo,Consolas,monospace;"><%= eyebrow %></p>
    <% } %>
    <h1 style="margin:12px 0 0;font-size:26px;line-height:1.25;font-weight:700;letter-spacing:-0.03em;color:<%= colors.onPrimary %>;"><%= title %></h1>
  </td>
</tr>
