<%- include('partials/shell-open', { pageTitle: 'Account deleted — ' + brandName }) %>
<%- include('partials/header', { eyebrow: 'Account lifecycle', title: 'Account deleted', tone: 'danger' }) %>
<tr>
  <td class="mail-body" style="padding:36px 36px 28px;">
    <h2 style="margin:0 0 12px;font-size:20px;color:<%= colors.text %>;letter-spacing:-0.02em;">Hello <%= name %>,</h2>
    <p style="margin:0 0 14px;font-size:15px;line-height:1.7;color:<%= colors.textMuted %>;">
      Your <strong style="color:<%= colors.text %>;"><%= brandName %></strong> account was deleted on
      <strong style="color:<%= colors.text %>;"><%= date %></strong>.
      Access to the admin CMS and protected areas is no longer available with this account.
    </p>

    <div class="mail-panel mail-panel-danger" style="background:<%= colors.dangerSoft %>;border-left:3px solid <%= colors.danger %>;border-radius:8px;padding:18px 20px;margin:22px 0;font-size:14px;color:<%= colors.text %>;">
      If you did not request this, contact support immediately so we can investigate.
    </div>

    <% if (supportEmail) { %>
      <%- include('partials/cta', { href: 'mailto:' + supportEmail + '?subject=' + encodeURIComponent('Account deletion — ' + brandName), label: 'Contact support', variant: 'danger' }) %>
    <% } %>
  </td>
</tr>
<%- include('partials/footer') %>
<%- include('partials/shell-close') %>
