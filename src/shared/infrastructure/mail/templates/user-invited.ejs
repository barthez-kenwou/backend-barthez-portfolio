<%- include('partials/shell-open', { pageTitle: 'Invitation — ' + brandName }) %>
<%- include('partials/header', { eyebrow: 'Admin invitation', title: 'Join the admin space', tone: 'brand' }) %>
<tr>
  <td class="mail-body" style="padding:36px 36px 28px;">
    <h2 style="margin:0 0 12px;font-size:20px;color:<%= colors.text %>;letter-spacing:-0.02em;">Hello <%= name %>,</h2>
    <p style="margin:0 0 14px;font-size:15px;line-height:1.7;color:<%= colors.textMuted %>;">
      You have been invited to the <strong style="color:<%= colors.text %>;"><%= brandName %></strong> admin CMS
      with the role <strong style="color:<%= colors.primary %>;"><%= role %></strong>.
    </p>

    <div class="mail-panel mail-panel-brand" style="background:<%= colors.primarySoft %>;border-left:3px solid <%= colors.primary %>;border-radius:8px;padding:18px 20px;margin:22px 0;font-size:14px;color:<%= colors.text %>;">
      Set your password to activate access. This link is unique to you — do not forward it.
    </div>

    <%- include('partials/cta', { href: inviteLink, label: 'Accept invitation', variant: 'brand' }) %>

    <p style="margin:16px 0 0;font-size:13px;line-height:1.6;color:<%= colors.textMuted %>;">
      Or open this link:<br/>
      <a href="<%= inviteLink %>" style="color:<%= colors.primary %>;word-break:break-all;"><%= inviteLink %></a>
    </p>

    <p style="margin:18px 0 0;font-size:14px;color:<%= colors.textMuted %>;">
      If you were not expecting this invitation, you can ignore this email.
    </p>
  </td>
</tr>
<%- include('partials/footer') %>
<%- include('partials/shell-close') %>
