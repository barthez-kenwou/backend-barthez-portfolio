<%
  var isEn = typeof locale !== 'undefined' && locale === 'en';
  var pageTitle = isEn ? 'This month on the blog' : 'Ce mois-ci sur le blog';
  var eyebrow = isEn ? 'Monthly digest' : 'Digest mensuel';
  var title = isEn ? 'Articles published recently' : 'Articles publiés récemment';
  var itemsList = (typeof items !== 'undefined' && items) ? items : [];
%>
<%- include('partials/newsletter-shell-open', { pageTitle: pageTitle, eyebrow: eyebrow, title: title, previewText: pageTitle }) %>
<tr>
  <td style="padding:32px 28px 26px;background-color:#0e0c11;">
    <p style="margin:0 0 14px;font-size:16px;line-height:1.7;color:#f7f7f7;">
      <%= isEn ? 'Hello' : 'Bonjour' %>,
    </p>
    <p style="margin:0 0 20px;font-size:15px;line-height:1.75;color:#948b9c;">
      <% if (isEn) { %>
        Here is what was published on the blog this month. Pick the topic that matches your current priority.
      <% } else { %>
        Voici ce qui a été publié sur le blog ce mois-ci. Choisissez le sujet qui correspond à votre priorité actuelle.
      <% } %>
    </p>
    <% itemsList.forEach(function (item) { %>
      <div style="margin:0 0 16px;padding:14px 16px;border-radius:6px;background:#17141a;border:1px solid #211d25;">
        <p style="margin:0 0 6px;font-size:11px;letter-spacing:0.12em;text-transform:uppercase;color:#9f6adc;font-weight:600;">
          <%= item.category %> · <%= item.readTime %>
        </p>
        <a href="<%= item.postUrl %>" style="color:#ffffff;font-size:16px;font-weight:700;text-decoration:none;line-height:1.35;display:block;margin:0 0 8px;">
          <%= isEn ? item.titleEn : item.titleFr %>
        </a>
        <p style="margin:0 0 10px;font-size:14px;line-height:1.65;color:#948b9c;">
          <%= isEn ? item.excerptEn : item.excerptFr %>
        </p>
        <a href="<%= item.postUrl %>" style="color:#9f6adc;font-size:13px;font-weight:600;text-decoration:none;">
          <%= isEn ? 'Read the article →' : 'Lire l’article →' %>
        </a>
      </div>
    <% }) %>
    <div style="text-align:center;margin:22px 0 8px;">
      <a href="<%= blogIndexUrl %>" style="display:inline-block;background-color:#9f6adc;color:#ffffff;padding:13px 26px;text-decoration:none;border-radius:6px;font-weight:700;font-size:14px;border:1px solid #803ecc;">
        <%= isEn ? 'Open the blog' : 'Ouvrir le blog' %>
      </a>
    </div>
    <p style="margin:24px 0 0;font-size:14px;line-height:1.6;color:#f7f7f7;">
      <%= isEn ? 'Kind regards,' : 'Cordialement,' %><br/>
      <strong style="color:#ffffff;">Barthez Kenwou</strong>
    </p>
  </td>
</tr>
<%- include('partials/newsletter-shell-close') %>
