<%- include('partials/shell-open', { pageTitle: brandName + ' — Verification code' }) %>
<%- include('partials/header', { eyebrow: 'Account verification', title: 'Confirm your email', tone: 'brand' }) %>
<tr>
  <td class="mail-body" style="padding:36px 36px 28px;">
    <h2 style="margin:0 0 12px;font-size:20px;color:<%= colors.text %>;letter-spacing:-0.02em;">Hello <%= name %>,</h2>
    <p style="margin:0 0 14px;font-size:15px;line-height:1.7;color:<%= colors.textMuted %>;">
      Use this one-time code to verify your email and finish setting up your
      <strong style="color:<%= colors.text %>;"><%= brandName %></strong> account.
    </p>

    <div class="mail-code" style="background:<%= colors.primarySoft %>;border:1px solid <%= colors.primary %>;color:<%= colors.ink %>;font-weight:700;font-size:34px;letter-spacing:12px;text-align:center;border-radius:8px;padding:24px 12px;margin:24px 0;font-family:'JetBrains Mono',ui-monospace,Menlo,Consolas,monospace;">
      <%= otp %>
    </div>

    <div class="mail-panel mail-panel-brand" style="background:<%= colors.primarySoft %>;border-left:3px solid <%= colors.primary %>;border-radius:8px;padding:18px 20px;margin:22px 0;font-size:14px;color:<%= colors.text %>;">
      This code expires in <strong>10 minutes</strong>. Never share it with anyone —
      <span style="color:<%= colors.primary %>;font-weight:600;"><%= brandName %></span> will never ask for it by chat or phone.
    </div>

    <p style="margin:0 0 14px;font-size:15px;line-height:1.7;color:<%= colors.textMuted %>;">
      If you did not create an account, you can safely ignore this message.
    </p>

    <% if (clientUrl) { %>
      <%- include('partials/cta', { href: clientUrl, label: 'Open ' + brandName, variant: 'brand' }) %>
    <% } %>
  </td>
</tr>
<%- include('partials/footer') %>
<%- include('partials/shell-close') %>
