<%
  var isEn = typeof locale !== 'undefined' && locale === 'en';
  var postTitle = isEn ? titleEn : titleFr;
  var excerpt = isEn ? excerptEn : excerptFr;
  var pageTitle = postTitle;
  var eyebrow = isEn ? 'New article' : 'Nouvel article';
  var title = isEn ? 'A new guide is available' : 'Un nouveau guide est disponible';
%>
<%- include('partials/newsletter-shell-open', { pageTitle: pageTitle, eyebrow: eyebrow, title: title, previewText: excerpt }) %>
<tr>
  <td style="padding:32px 28px 26px;background-color:#0e0c11;">
    <p style="margin:0 0 14px;font-size:16px;line-height:1.7;color:#f7f7f7;">
      <%= isEn ? 'Hello' : 'Bonjour' %>,
    </p>
    <p style="margin:0 0 10px;font-size:11px;letter-spacing:0.12em;text-transform:uppercase;color:#9f6adc;font-weight:600;">
      <%= category %> · <%= readTime %>
    </p>
    <h2 style="margin:0 0 14px;font-size:20px;line-height:1.35;color:#ffffff;font-weight:700;letter-spacing:-0.02em;">
      <%= postTitle %>
    </h2>
    <% if (typeof image !== 'undefined' && image) { %>
      <a href="<%= postUrl %>" style="display:block;margin:0 0 16px;">
        <img src="<%= image %>" alt="" width="536" style="width:100%;max-width:536px;height:auto;border-radius:6px;border:1px solid #211d25;display:block;" />
      </a>
    <% } %>
    <p style="margin:0 0 16px;font-size:15px;line-height:1.75;color:#948b9c;">
      <%= excerpt %>
    </p>
    <p style="margin:0 0 20px;font-size:15px;line-height:1.75;color:#f7f7f7;">
      <% if (isEn) { %>
        Inside: a concrete takeaway — tools, method, and mistakes already paid for in production.
      <% } else { %>
        À l’intérieur&nbsp;: un enseignement concret — outils, méthode, et erreurs déjà payées en production.
      <% } %>
    </p>
    <div style="text-align:center;margin:8px 0 8px;">
      <a href="<%= postUrl %>" style="display:inline-block;background-color:#9f6adc;color:#ffffff;padding:13px 26px;text-decoration:none;border-radius:6px;font-weight:700;font-size:14px;border:1px solid #803ecc;">
        <%= isEn ? 'Read the full article' : 'Lire l’article complet' %>
      </a>
    </div>
    <p style="margin:24px 0 0;font-size:14px;line-height:1.6;color:#f7f7f7;">
      <%= isEn ? 'Kind regards,' : 'Cordialement,' %><br/>
      <strong style="color:#ffffff;"><%= typeof author !== 'undefined' ? author : 'Barthez Kenwou' %></strong>
    </p>
  </td>
</tr>
<%- include('partials/newsletter-shell-close') %>
