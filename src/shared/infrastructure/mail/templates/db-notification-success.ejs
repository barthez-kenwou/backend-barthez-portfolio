<%- include('partials/shell-open', { pageTitle: 'Backup completed — ' + brandName }) %>
<%- include('partials/header', { eyebrow: 'Ops notification', title: 'Database backup completed', tone: 'success' }) %>
<tr>
  <td class="mail-body" style="padding:36px 36px 28px;">
    <h2 style="margin:0 0 12px;font-size:20px;color:<%= colors.text %>;letter-spacing:-0.02em;">Hello,</h2>
    <p style="margin:0 0 14px;font-size:15px;line-height:1.7;color:<%= colors.textMuted %>;">
      The automatic database backup for
      <strong style="color:<%= colors.text %>;"><%= brandName %></strong> finished successfully.
    </p>

    <div class="mail-panel mail-panel-success" style="background:<%= colors.successSoft %>;border-left:3px solid <%= colors.success %>;border-radius:8px;padding:18px 20px;margin:22px 0;">
      <div class="mail-meta-row" style="padding:10px 0;border-bottom:1px dashed <%= colors.border %>;">
        <span class="mail-meta-label" style="display:block;margin-bottom:3px;color:<%= colors.textMuted %>;font-weight:600;font-size:10px;letter-spacing:0.12em;text-transform:uppercase;">Backup date</span>
        <span class="mail-meta-value" style="color:<%= colors.text %>;font-size:14px;"><%= date %></span>
      </div>
      <div class="mail-meta-row" style="padding:10px 0;border-bottom:1px dashed <%= colors.border %>;">
        <span class="mail-meta-label" style="display:block;margin-bottom:3px;color:<%= colors.textMuted %>;font-weight:600;font-size:10px;letter-spacing:0.12em;text-transform:uppercase;">File location</span>
        <span class="mail-meta-value" style="color:<%= colors.text %>;font-size:14px;word-break:break-all;"><%= backupPath %></span>
      </div>
      <div class="mail-meta-row" style="padding:10px 0;border-bottom:1px dashed <%= colors.border %>;">
        <span class="mail-meta-label" style="display:block;margin-bottom:3px;color:<%= colors.textMuted %>;font-weight:600;font-size:10px;letter-spacing:0.12em;text-transform:uppercase;">File size</span>
        <span class="mail-meta-value" style="color:<%= colors.text %>;font-size:14px;"><%= size %></span>
      </div>
      <div class="mail-meta-row" style="padding:10px 0;">
        <span class="mail-meta-label" style="display:block;margin-bottom:3px;color:<%= colors.textMuted %>;font-weight:600;font-size:10px;letter-spacing:0.12em;text-transform:uppercase;">Duration</span>
        <span class="mail-meta-value" style="color:<%= colors.text %>;font-size:14px;"><%= duration %></span>
      </div>
    </div>

    <% if (backupPath && String(backupPath).indexOf('http') === 0) { %>
      <%- include('partials/cta', { href: backupPath, label: 'Open backup location', variant: 'success' }) %>
    <% } %>

    <p style="margin:16px 0 0;font-size:14px;color:<%= colors.textMuted %>;">
      Keep an off-site copy as part of your recovery plan.
    </p>
  </td>
</tr>
<%- include('partials/footer') %>
<%- include('partials/shell-close') %>
