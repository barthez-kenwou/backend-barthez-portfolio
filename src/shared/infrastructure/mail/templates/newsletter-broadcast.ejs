<%
  var isEn = typeof locale !== 'undefined' && locale === 'en';
  var headline = isEn ? headlineEn : headlineFr;
  var body = isEn ? bodyEn : bodyFr;
  var ctaLabel = isEn ? (ctaLabelEn || 'Read more') : (ctaLabelFr || 'Lire la suite');
  var pageTitle = headline;
%>
<%- include('partials/newsletter-shell-open', { pageTitle: pageTitle, eyebrow: isEn ? 'From Barthez' : 'De la part de Barthez', title: headline, previewText: typeof previewText !== 'undefined' ? previewText : headline }) %>
<tr>
  <td style="padding:36px 32px 28px;background-color:#0e0c11;">
    <div style="font-size:15px;line-height:1.75;color:#948b9c;white-space:pre-wrap;"><%= body %></div>
    <% if (typeof ctaUrl !== 'undefined' && ctaUrl) { %>
      <div style="text-align:center;margin:28px 0 8px;">
        <a href="<%= ctaUrl %>" style="display:inline-block;background-color:#9f6adc;color:#ffffff;padding:14px 30px;text-decoration:none;border-radius:6px;font-weight:700;font-size:14px;border:1px solid #803ecc;">
          <%= ctaLabel %>
        </a>
      </div>
    <% } %>
  </td>
</tr>
<%- include('partials/newsletter-shell-close') %>
