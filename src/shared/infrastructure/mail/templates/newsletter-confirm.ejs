<%
  var isEn = typeof locale !== 'undefined' && locale === 'en';
  var pageTitle = isEn ? 'Confirm your subscription' : 'Confirmer votre abonnement';
  var eyebrow = isEn ? 'One step left' : 'Une dernière étape';
  var title = isEn ? 'Please confirm your email' : 'Veuillez confirmer votre adresse';
%>
<%- include('partials/newsletter-shell-open', { pageTitle: pageTitle, eyebrow: eyebrow, title: title, previewText: isEn ? 'Confirm your subscription to Barthez Kenwou technical notes.' : 'Confirmez votre inscription aux notes techniques Barthez Kenwou.' }) %>
<tr>
  <td style="padding:32px 28px 26px;background-color:#0e0c11;">
    <p style="margin:0 0 14px;font-size:16px;line-height:1.7;color:#f7f7f7;">
      <%= isEn ? 'Hello' : 'Bonjour' %>,
    </p>
    <p style="margin:0 0 14px;font-size:15px;line-height:1.75;color:#948b9c;">
      <% if (isEn) { %>
        Someone (hopefully you) requested to join the <strong style="color:#f7f7f7;">Barthez Kenwou</strong> newsletter —
        practical notes on DevOps, full stack, AWS, and systems that stay reliable in production.
      <% } else { %>
        Quelqu’un (idéalement vous) a demandé à rejoindre la newsletter de <strong style="color:#f7f7f7;">Barthez Kenwou</strong> —
        notes concrètes sur le DevOps, le full stack, AWS, et les systèmes fiables en production.
      <% } %>
    </p>
    <p style="margin:0 0 22px;font-size:15px;line-height:1.75;color:#948b9c;">
      <% if (isEn) { %>
        Please confirm with the button below. One edition per month. You can unsubscribe in one click at any time.
      <% } else { %>
        Merci de confirmer via le bouton ci-dessous. Une édition par mois. Désabonnement en un clic à tout moment.
      <% } %>
    </p>
    <div style="text-align:center;margin:28px 0 12px;">
      <a href="<%= confirmUrl %>" style="display:inline-block;background-color:#9f6adc;color:#ffffff;padding:13px 26px;text-decoration:none;border-radius:6px;font-weight:700;font-size:14px;border:1px solid #803ecc;">
        <%= isEn ? 'Confirm my subscription' : 'Confirmer mon abonnement' %>
      </a>
    </div>
    <p style="margin:20px 0 0;font-size:12px;line-height:1.6;color:#948b9c;">
      <%= isEn ? 'This link expires in 48 hours. If you did not request this, you can ignore this email.' : 'Ce lien est valable 48&nbsp;h. Si vous n’êtes pas à l’origine de cette demande, ignorez ce message.' %>
    </p>
  </td>
</tr>
<%- include('partials/newsletter-shell-close') %>
