
PORT=3000
NODE_ENV=development

DB_TYPE=mongodb
APP_NAME=Barthez-Kenwou-Portfolio-API
APP_DESCRIPTION="Backend API for barthez-kenwou.dev — portfolio CMS, auth, and public content"
APP_AUTHOR="Barthez Kenwou"
APP_VERSION=1.0.0
APP_LICENSE=UNLICENSED
APP_TZ=UTC
APP_LOCALE=en-US
SERVER_URL=http://localhost:3000

DEFAULT_API_PREFIX=/api/v1
# Deprecated — unused by middleware. Prefer MAX_GLOBAL_QUERY_* / MAX_UNIQ_QUERY_* / MAX_AUTH_QUERY_*.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
DISABLE_CONSOLE_LOGS=true
MAINTENANCE_MODE=false
TRUST_PROXY_HOPS=1
# all = HTTP + workers | api = HTTP only | worker = BullMQ only (no listen)
PROCESS_ROLE=all
# Host-run tip: set DATABASE_URL/REDIS_HOST/SMTP_HOST/MINIO_ENDPOINT/CLAMAV_HOST to 127.0.0.1
# and raise MAX_*_QUERY_NUMBER for local smoke suites.
HTTP_REQUEST_TIMEOUT_MS=30000

DATABASE_URL="mongodb://admin:secret123@mongo:27017/portfolioDB?replicaSet=rs0&authSource=admin"
# Optional alternate Mongo URL used by some tools (Compose mongo-backup). Prefer DATABASE_URL for the API.
MONGO_URL=mongodb://admin:secret123@mongo:27017/
LOG_TO_MONGODB=false

# MongoDB
MONGO_NAME=PORTFOLIO_DB
MONGO_USER=admin
MONGO_PASSWORD=secret123
MONGO_DB=portfolioDB
MONGO_PORT=27017

# Redis
REDIS_NAME=PORTFOLIO_CACHE
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_TLS=false
REDIS_TLS_REJECT_UNAUTHORIZED=true
REDIS_DB=0
REDISINSIGHT_NAME=REDISINSIGHT
REDISINSIGHT_PORT=8001

# Prisma Studio (dev only — tools profile / npm run prisma:studio)
PRISMA_STUDIO_NAME=PRISMA_STUDIO
PRISMA_STUDIO_PORT=5555

# MinIO
MINIO_NAME=PORTFOLIO_STORAGE
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minio123
MINIO_PORT=9000
MINIO_CONSOLE=9001
MINIO_ENDPOINT=minio
MINIO_APP_BUCKET=app-uploads
MINIO_BASE_PATH=uploads/
MINIO_USE_SSL=false
MINIO_PUBLIC_URL=http://localhost:9000
MINIO_BACKUP_BUCKET=backups

# Mail identity (defaults to APP_NAME if empty)
MAIL_FROM_NAME=Barthez Kenwou
# Support address shown in footers (falls back to USER_EMAIL)
MAIL_SUPPORT_EMAIL=kenwoubarthez@gmail.com

# ---------------------------------------------------------------------------
# Transactional mail brand kit — Pearl & Amethyst (barthez-kenwou.dev)
# Defaults: src/shared/constants/mail-brand.constants.ts
# Leave social / legal URLs empty to hide them in the footer.
# ---------------------------------------------------------------------------
MAIL_BRAND_NAME=Barthez Kenwou
MAIL_BRAND_MONOGRAM=BK
MAIL_BRAND_PRIMARY=#622ba1
MAIL_BRAND_PRIMARY_DARK=#4b2a78
MAIL_BRAND_PRIMARY_MID=#814ebc
MAIL_BRAND_PRIMARY_SOFT=#f2eef6
MAIL_BRAND_ACCENT=#22d3ee
MAIL_BRAND_SUCCESS=#059669
MAIL_BRAND_SUCCESS_DARK=#047857
MAIL_BRAND_SUCCESS_SOFT=#d1fae5
MAIL_BRAND_WARNING=#d97706
MAIL_BRAND_WARNING_DARK=#b45309
MAIL_BRAND_WARNING_SOFT=#fef3c7
MAIL_BRAND_DANGER=#d32222
MAIL_BRAND_DANGER_DARK=#b91c1c
MAIL_BRAND_DANGER_SOFT=#fee2e2
MAIL_BRAND_CANVAS=#fbfafd
MAIL_BRAND_CARD=#ffffff
MAIL_BRAND_TEXT=#1f1627
MAIL_BRAND_TEXT_MUTED=#61556d
MAIL_BRAND_BORDER=#e0dce5
MAIL_BRAND_FOOTER_BG=#f9f7fb
MAIL_BRAND_ON_PRIMARY=#ffffff
MAIL_BRAND_INK=#241a2e
MAIL_BRAND_SPECTRUM_1=#7c3aed
MAIL_BRAND_SPECTRUM_2=#22d3ee
MAIL_BRAND_SPECTRUM_3=#e879f9
MAIL_LOGO_URL=https://barthez-kenwou.dev/icons/logo-mark.png
MAIL_FOOTER_TAGLINE=Full Stack Developer & DevOps Engineer
MAIL_FOOTER_COMPANY=Barthez Kenwou
MAIL_FOOTER_ADDRESS=Yaoundé, Cameroun
MAIL_FOOTER_PHONE=+237 655 646 688
MAIL_FOOTER_WEBSITE_LABEL=Visit barthez-kenwou.dev
MAIL_PRIVACY_URL=
MAIL_TERMS_URL=
MAIL_HELP_URL=https://barthez-kenwou.dev/contact
MAIL_SOCIAL_FACEBOOK=
MAIL_SOCIAL_INSTAGRAM=
MAIL_SOCIAL_LINKEDIN=https://linkedin.com/in/barthez-kenwou
MAIL_SOCIAL_TWITTER=
MAIL_SOCIAL_YOUTUBE=
MAIL_SOCIAL_GITHUB=https://github.com/barthez-kenwou
MAIL_SOCIAL_TIKTOK=

BACKUP_NAME=BACKEND_BACKUP
BACKUP_CRON=0 0 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_ADMIN_EMAIL=admin@example.com
BACKUP_SERVICE_EMAIL=backup@example.com
MAINTENANCE_CRON=0 0 * * *
BLACKLIST_PURGE_CRON=0 */6 * * *
AUDIT_PURGE_CRON=15 3 * * *
AUDIT_RETENTION_DAYS=365

# MailHog SMTP
SMTP_NAME=BACKEND_MAIL
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_WEB_UI=8025
SMTP_USER=smtp_user
SMTP_PASS=smtp_password
USER_EMAIL=kenwoubarthez@gmail.com

# Nginx
NGINX_NAME=BACKEND_NGINX
NGINX_PORT=80
NGINX_SSH=443
NGINX_HOST=www.host.com

# ClamAV
CLAMAV_NAME=BACKEND_CLAMAV
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_TIMEOUT=20000
CLAMAV_REQUIRED=false

# Multipart through the API is avatars only (2MB). Larger objects use presigned PUT.
API_UPLOAD_MAX_BYTES=2097152
PRESIGN_UPLOAD_MAX_BYTES=52428800
PRESIGN_TTL_SECONDS=300

CLIENT_URL=http://localhost:5173
CLIENT_URLS=https://barthez-kenwou.dev,http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# jwt (RS256 — PEM paths below; no HMAC secret)
# Deprecated — not used for signing. Prefer JWT_ACCESS_EXPIRES_IN / JWT_REFRESH_EXPIRES_IN.
JWT_EXPIRES_IN=1h
JWT_COOKIE_SECURITY=true
JWT_COOKIE_HTTP_STATUS=true
# Ignored — algorithm is fixed to RS256 in code (alg confusion hardening).
JWT_ALGORITHM=RS256
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_PRIVATE_KEY_PATH=keys/jwt-access-private.pem
JWT_PUBLIC_KEY_PATH=keys/jwt-access-public.pem
JWT_REFRESH_PRIVATE_KEY_PATH=keys/jwt-refresh-private.pem
JWT_REFRESH_PUBLIC_KEY_PATH=keys/jwt-refresh-public.pem

# rate limiting
MAX_GLOBAL_QUERY_NUMBER=100
MAX_GLOBAL_QUERY_WINDOW=900000 # 15 minutes
MAX_UNIQ_QUERY_NUMBER=200
MAX_UNIQ_QUERY_WINDOW=900000 # 15 minutes

# Security
HSTS_MAX_AGE=31536000
HSTS_PRELOAD=false

# Logging
# Ops path: stdout (+ Loki when enabled). File transports only if LOG_TO_FILE=true
# (local debugging — not a production archive).
LOG_LEVEL=info
LOG_TO_FILE=false
LOKI_ENABLED=false
LOKI_HOST=http://loki:3100
OTEL_ENABLED=false

# Csurf
ALLOW_CSRF_PROTECTION=true
CSRF_COOKIE_NAME=XSRF-TOKEN
CSRF_HEADER_NAME=X-XSRF-TOKEN
CSRF_EXPIRES_IN=24h

# Cookies (maxAge = duration; empty COOKIE_DOMAIN = host-only)
COOKIE_DOMAIN=
COOKIE_SECURE=true
COOKIE_HTTP_STATUS=true
COOKIE_HTTP_ONLY=true
COOKIE_SAME_SITE=strict
COOKIE_EXPIRES_IN=7d

# Auth lockout / OTP
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MS=900000
MAX_OTP_ATTEMPTS=5
MAX_AUTH_QUERY_NUMBER=10
MAX_AUTH_QUERY_WINDOW=900000
PASSWORD_RESET_EXPIRES_IN=1h

# AES-256-GCM for OAuth provider tokens at rest (64-char hex or passphrase)
AUTH_ENCRYPTION_KEY=

# OAuth post-login redirect allowlist (CLIENT_URL is always included)
OAUTH_ALLOWED_ORIGINS=

# Swagger / operator UIs (off in production by default)
SWAGGER_ENABLED=true
SWAGGER_USER=admin
SWAGGER_PASSWORD=admin
ADMIN_BASIC_USER=admin
ADMIN_BASIC_PASSWORD=

# CSP Reporting
CSP_REPORT_URI=/security/csp-violation

# OTP
OTP_DELAY=900000 # 15 minutes
OTP_RESEND_COOLDOWN=60000 # min wait between OTP emails (signup / resend)

# Local Cache
LOCAL_CACHE_TTL=120000
LOCAL_CACHE_MAX_ITEMS=100
COMPRESSION_THRESHOLD=1024


# ============================================
# OAuth2.0 Configuration
# ============================================

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/oauth/google/callback

# GitHub OAuth
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_REDIRECT_URI=http://localhost:3000/api/v1/auth/oauth/github/callback

# Facebook OAuth
FACEBOOK_CLIENT_ID=your_facebook_app_id
FACEBOOK_CLIENT_SECRET=your_facebook_app_secret
FACEBOOK_REDIRECT_URI=http://localhost:3000/api/v1/auth/oauth/facebook/callback

# Instagram OAuth (Basic Display API)
INSTAGRAM_CLIENT_ID=your_instagram_client_id
INSTAGRAM_CLIENT_SECRET=your_instagram_client_secret
INSTAGRAM_REDIRECT_URI=http://localhost:3000/api/v1/auth/oauth/instagram/callback

# Twitter OAuth 2.0
TWITTER_CLIENT_ID=your_twitter_client_id
TWITTER_CLIENT_SECRET=your_twitter_client_secret
TWITTER_REDIRECT_URI=http://localhost:3000/api/v1/auth/oauth/twitter/callback

# LinkedIn OAuth (OpenID Connect)
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
LINKEDIN_REDIRECT_URI=http://localhost:3000/api/v1/auth/oauth/linkedin/callback

# Telegram Bot (for Login Widget)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_BOT_USERNAME=your_telegram_bot_username

# ============================================
# Storage
# ============================================
STORAGE_PROVIDER=minio
S3_ENDPOINT=
S3_PORT=443
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_REGION=us-east-1
S3_USE_SSL=false
S3_PUBLIC_URL=

# ============================================
# Auth tokens
# ============================================
REFRESH_TOKEN_COOKIE=refresh_token
BACKUP_ENCRYPTION_KEY=change-me-to-a-32-char-secret-key!!

# ============================================
# Feature flags (Flagsmith)
# ============================================
# Leave empty to use defaults + optional FEATURE_* overrides only.
FLAGSMITH_API_KEY=
# Host backend → tools Flagsmith: http://127.0.0.1:8000/api/v1/
# Backend in Compose → tools Flagsmith: http://flagsmith:8000/api/v1/
FLAGSMITH_API_URL=
FLAGSMITH_REFRESH_SECONDS=60
# Local kill-switches (win over Flagsmith when set): true|false|1|0|on|off
FEATURE_ENABLE_OAUTH=
FEATURE_ENABLE_BACKUP=
FEATURE_ENABLE_MAINTENANCE_JOBS=
# Compose tools profile (optional)
FLAGSMITH_PORT=8000

# ============================================
# Infisical (placeholders only — not wired)
# ============================================
# Mapped into config.features.infisical for future use. This backend does NOT
# fetch secrets from Infisical at boot. Materialize .env yourself (CLI export,
# Vault, etc.) — see docs/deployment/github-vps.md and production.md.
INFISICAL_CLIENT_ID=
INFISICAL_CLIENT_SECRET=
INFISICAL_PROJECT_ID=
INFISICAL_ENVIRONMENT=dev
